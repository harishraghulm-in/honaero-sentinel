{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honaero.sentinel/schemas/HarnessResult.json",
  "title": "HarnessResult",
  "description": "Generated artifact manifest and SHA-256 cryptographic checksums for harness build.",
  "type": "object",
  "required": ["success", "harness_source_file", "stubs_header_file", "stubs_source_file", "generated_code_hash"],
  "properties": {
    "success": { "type": "boolean" },
    "harness_source_file": { "type": "string" },
    "stubs_header_file": { "type": "string" },
    "stubs_source_file": { "type": "string" },
    "test_vectors_source_file": { "type": "string" },
    "build_script_file": { "type": "string" },
    "generated_code_hash": { "type": "string" },
    "error_message": { "type": "string" }
  }
}
