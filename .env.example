# HonAero Sentinel - Environment Configuration
APP_NAME="HonAero Sentinel API"
APP_ENV=development
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_secret@localhost:5432/sentinel_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Verification Toolchains & Compilers
GCC_PATH=C:\msys64\ucrt64\bin\gcc.exe
GCOV_PATH=C:\msys64\ucrt64\bin\gcov.exe
CLANG_PATH=clang
CMAKE_PATH=cmake

# Execution Engine & Worker Isolation
EXECUTION_ENGINE=local_process
EXECUTION_TIMEOUT_SECONDS=10
MAX_SOURCE_SIZE_BYTES=5242880
MAX_ARTIFACT_SIZE_BYTES=52428800
ARTIFACT_STORAGE_PATH=./storage/artifacts
WORKSPACE_BASE_PATH=./workspaces

# Docker Execution Worker (Production Isolation)
DOCKER_IMAGE=honaero-sentinel/execution-worker:latest
DOCKER_NETWORK=sentinel-isolated
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json

