# HonAero Sentinel Environment Configuration Example
APP_NAME="HonAero Sentinel API"
APP_ENV="development"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database Persistence
DATABASE_URL="sqlite:///./sentinel_dev.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Compiler & Verification Toolchains
# Leave as gcc / gcov if they are on your system PATH, or specify full path
GCC_PATH="gcc"
GCOV_PATH="gcov"
CLANG_PATH="clang"
CMAKE_PATH="cmake"

# Execution Worker Sandbox & Limits
EXECUTION_ENGINE="local_process"  # local_process or docker
EXECUTION_TIMEOUT_SECONDS=10
MAX_SOURCE_SIZE_BYTES=5242880
MAX_ARTIFACT_SIZE_BYTES=52428800
ARTIFACT_STORAGE_PATH="./storage/artifacts"
WORKSPACE_BASE_PATH="./workspaces"

# Docker Worker (when EXECUTION_ENGINE=docker)
DOCKER_IMAGE="honaero-sentinel/execution-worker:latest"
DOCKER_NETWORK="sentinel-isolated"
DOCKER_MEMORY_LIMIT="512m"
DOCKER_CPU_LIMIT=1.0

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# NVIDIA NIM AI Assistant (Optional - Deterministic Core operates independently)
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_DEFAULT_MODEL="meta/llama-3.3-70b-instruct"
